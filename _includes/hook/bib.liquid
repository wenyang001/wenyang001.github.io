{% if proceedings contains entry.type %}
  {% assign entrytype = entrytype | replace_first: '<em>In ', '<em>' %}
{% endif %}
{% if entry.co_first %}
  <div class="publication-author-note">* Co-first authors</div>
{% endif %}
{% if entry.author_note %}
  <div class="publication-author-note">{{ entry.author_note }}</div>
{% endif %}
{% if entry.ccf or entry.cas or entry.jcr or entry.citations %}
  <div class="rankings">
    {% if entry.ccf %}
      <span class="ranking-badge ranking-ccf">CCF {{ entry.ccf }}</span>
    {% endif %}
    {% if entry.cas %}
      <span class="ranking-badge ranking-cas">CAS {{ entry.cas }}</span>
    {% endif %}
    {% if entry.jcr %}
      <span class="ranking-badge ranking-jcr">JCR {{ entry.jcr }}</span>
    {% endif %}
    {% if entry.citations %}
      <span class="ranking-badge ranking-citations">{{ entry.citations }} citations</span>
    {% endif %}
  </div>
{% endif %}
