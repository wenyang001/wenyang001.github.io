---
layout: default
---
{% include publication_list_style.html %}
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
    {% if page.contact_line %}<p class="header-contact">{{ page.contact_line }}</p>{% endif %}
  </header>

  <article>
    <div class="about-intro clearfix">
      {% if page.profile %}
        <aside class="profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: 768px) 190px, 170px{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image cache_bust=true %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </aside>
      {% endif %}

      <div class="about-summary">{{ page.intro | markdownify }}</div>
      <div class="about-body">{{ content }}</div>
    </div>

    {% if page.research_tags %}
      <div class="research-tags" aria-label="Research interests">
        {% for tag in page.research_tags %}
          <span>{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">{{ page.announcements_label | default: 'news' }}</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.project_experience %}
      <h2>{{ page.project_experience_label | default: 'project experience' }}</h2>
      {% include project_experience.liquid projects=page.project_experience %}
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">{{ page.latest_posts_label | default: 'latest posts' }}</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">{{ page.selected_papers_label | default: 'selected publications' }}</a>
      </h2>
      <div class="publications about-selected-publications">
        {% bibliography --group_by none --query @*[homepage=true]* --template about_bib %}
      </div>
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
